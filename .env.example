# ==============================================================================
# Database Configuration
# ==============================================================================
# For Local MySQL:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_local_password
# DB_NAME=smart_care_hospital
# DB_SSL=false

# For TiDB Cloud (Serverless) / Cloud MySQL:
DB_HOST=your
DB_PORT=4000
DB_USER=your_gemini_api_key_here
DB_PASSWORD=your_gemini_api_key_here
DB_NAME=smart_care_hospital
DB_SSL=true

# Database SSL CA Certificate (Optional for TiDB Cloud):
# TiDB Cloud certificates are signed by standard public Root CAs (e.g. Let's Encrypt / ISRG Root X1)
# and are verified by Node.js with strict rejectUnauthorized: true.
# If a custom CA is required, DB_SSL_CA supports either:
# 1) A local file path: /etc/ssl/certs/isrgrootx1.pem
# 2) Direct PEM certificate text supplied as an env string (newlines or escaped \n):
#    DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DB_SSL_CA=

# Migration Control:
# Set to 'false' on production to skip migrations and preserve all existing data & tables
RUN_MIGRATIONS=false

# Connection Pool Limit (default: 15)
DB_CONNECTION_LIMIT=15

# ==============================================================================
# Server Configuration (Render / Production / Local)
# ==============================================================================
# Render automatically provides process.env.PORT. Default is 5000 for local.
PORT=5000
JWT_SECRET=your_local_password

# ==============================================================================
# Frontend Configuration (Vite)
# ==============================================================================
# In production on Firebase Hosting, point to your deployed Render backend API URL:
VITE_API_URL=https://shri-gajanan-hospital.onrender.com
# For Local Development:
# VITE_API_URL=http://localhost:5000

# ==============================================================================
# Optional AI Assistant Keys (Gemini or OpenAI)
# ==============================================================================
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
